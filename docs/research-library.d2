vars: {
  d2-config: {
    layout-engine: tala
    pad: 16
  }
}

...@editorial-theme
direction: right

question: Question {class: entity}
library: Local library {class: [entity; accent]}
answer: Answer {class: entity}
web: Web sources {class: entity}

question -> library: {class: flow}
library -> answer: {class: flow}
library -> web: fill gaps {class: flow}
web -> library: save originals {class: [flow; secondary-connection]}
